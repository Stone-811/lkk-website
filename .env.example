# 本機開發用的環境變數範本。複製成 .env 後填值（.env 已被 .gitignore 忽略）。
#
# ⚠️ 這份只列「程式碼真的會讀」的變數。線上不看這個檔案——
#    dev / prod 的設定各自寫在該分支的 apphosting.yaml。
#
# ⚠️ 本專案的慣例是「改動一律驗 dev 站，不開 localhost」。
#    本機沒有 ADC，Firestore 讀寫預設不會通，這是刻意的。

# ── 站台網址 ────────────────────────────────────────────────
# 只被 server/utils/email.ts 用來組通知信裡的後台連結。
# ⚠️ 必須是「這個環境自己的網址」。填成別站會讓信裡的連結指到別的地方。
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase Admin SDK（伺服器端）────────────────────────────
# 全站唯一的 Firestore 入口是 server/utils/firebase.ts，用 firebase-admin。
# 憑證解析順序：FIRESTORE_EMULATOR_HOST → service account → applicationDefault()。
FIREBASE_PROJECT_ID=lkkdev
FIREBASE_STORAGE_BUCKET=lkkdev.firebasestorage.app

# service account 憑證（選填）。三個都填才會走 cert() 那條分支；
# 沒填就落到 ADC。線上（App Hosting）不填，由平台自動注入 ADC。
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@lkkdev.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Firestore 模擬器（選填）。設了就優先走模擬器。
# ⚠️ 連模擬器用的一樣是 Admin SDK，同樣繞過 Security Rules。
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ── 後台驗證 ────────────────────────────────────────────────
# 自簽 JWT 的簽章密鑰，至少 32 字元。
JWT_SECRET=your-jwt-secret-here-at-least-32-characters

# Google 登入的白名單（逗號分隔）。這是「誰能登入後台」，跟寄信無關。
ADMIN_ALLOWED_EMAILS=lkkwellness@gmail.com,service@l-kk.tw

# 內建開發管理員（admin@l-kk.tw / admin123）。雙重閘門：
# 必須 NODE_ENV !== 'production' 且此值為 'true' 才生效。線上永遠不會通。
# ALLOW_DEV_ADMIN=true

# ── Firebase Web SDK（前端，僅用於後台 Google 登入）──────────
# 這些是公開值，可以出現在瀏覽器。前端只載入 firebase/app 與 firebase/auth，
# 沒有任何 firebase/firestore。
NUXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lkkdev.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=lkkdev
NUXT_PUBLIC_FIREBASE_APP_ID=1:xxxxxxxxx:web:xxxxxxxxxxxx

# ── 寄信（SMTP）─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# ⚠️ SMTP_USER 必須是「能登入的真帳號」。service@l-kk.tw 是 lkk@l-kk.tw 的別名，
#    別名沒有自己的應用程式密碼，拿來當 SMTP_USER 會得到 535-5.7.8 BadCredentials。
SMTP_USER=lkk@l-kk.tw
# ⚠️ 必須是 SMTP_USER 那個帳號的「應用程式密碼」。
SMTP_PASS=your-app-password
# SMTP_FROM 可以用別名（Workspace 允許以自己網域的別名寄信）。
SMTP_FROM=service@l-kk.tw
# 收件者按「回覆」時會寄到這裡（選填，預設 service@l-kk.tw）。
# SMTP_REPLY_TO=service@l-kk.tw
# 只有 Firestore settings/notifications.emailRecipients 為空時才會用到的保底值。
NOTIFICATION_EMAIL=service@l-kk.tw
