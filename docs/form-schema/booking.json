{
  "formId": "booking",
  "schemaVersion": "1.0",
  "describes": "練健康官網 /booking「預約體驗」表單的現況（2026-11-08，dev 與正式站相同）。這份是描述檔，網站本身還沒有讀它。",
  "sourceOfTruth": [
    "pages/booking.vue",
    "server/api/leads/booking.post.ts",
    "server/utils/leads.ts",
    "config/formOptions.ts",
    "config/referralSources.ts",
    "config/bookingVariants.ts",
    "config/freeTrialPartners.ts",
    "composables/useUtm.ts"
  ],
  "conventions": {
    "condition": "條件寫法：{\"field\":<欄位 key>,\"op\":<運算>,\"value\":<值>}；運算有 eq、neq、in、notIn、includes（多選含某值）、truthy、falsy、gte。field 以 \"$variant.\" 開頭時讀網址變體設定、以 \"$derived.\" 開頭時讀衍生值。多個條件用 {\"all\":[…]} 或 {\"any\":[…]} 組合。 field 以 \"$state.\" 開頭時讀畫面狀態（例如 isSubmitting）。",
    "required": "required 為 true／false，或一個條件物件（條件成立才必填）。",
    "showIf": "showIf 不成立時欄位不顯示、不驗證，送出值見各欄位 store.whenHidden。",
    "options": "選項的 value 就是存進資料庫的字，label 是畫面上的字；兩者相同時只寫 value。value 收到名單後不要改字（舊名單無法回填，CSV 會裂成兩種寫法）；選項只新增或停用。",
    "store.path": "存進 Firestore 集合 leads 的位置：頂層欄位直接寫名稱，其他寫 payload.<名稱>。",
    "trim": "必填判斷用去掉前後空白後的值；存進資料庫的是原值（沒有 trim），除非另外註明。",
    "arrays": "多選欄位存成陣列時，順序是使用者點選的先後，不是選項順序。",
    "rawValue": "「有值」若沒特別註明，指原值非空字串（只打空白也算有值）；格式檢查也用原值，不去前後空白。"
  },
  "submit": {
    "endpoint": "POST /api/leads/booking",
    "contentType": "application/json",
    "buttonText": "送出預約",
    "submittingText": "送出中...",
    "onFailure": {
      "httpError": "alert「送出失敗，請稍後再試」",
      "networkError": "alert「網路錯誤，請稍後再試」",
      "note": "兩種都不顯示伺服器回傳的 error 文字"
    },
    "onSuccess": {
      "container": "id=\"lead-success\"、data-form=\"booking\"（GTM 轉換靠它觸發，不要改）",
      "title": "預約成功！",
      "body": "我們將於 2~3 天內主動與你聯繫確認體驗課時間{填了 Email 才加：，並寄送 Email 通知你}。",
      "lineHint": "為了更快為你服務，我們已為你預填預約資訊，請點下方按鈕加入官方 LINE，直接送出即可（訊息需由你親自按下傳送）。",
      "lineButton": "加入官方 LINE 並傳送預約資訊",
      "lineMessageTemplate": "你好，我是 {name trim}，我已報名練健康{有選分店時：半形空格＋分店名} 的個人教練體驗課，請協助確認。",
      "lineUrlFormat": "https://line.me/R/oaMessage/@201fzruh/?{encodeURIComponent(訊息)}",
      "addFriend": {
        "text": "還不是官方 LINE 好友？先點此加入好友",
        "url": "https://line.me/R/ti/p/%40201fzruh"
      }
    },
    "serverValidation": [
      "name、phone、storeId、preferredTime（至少一項）缺任一項 → 400「請填寫必要欄位」",
      "phone 不符合 ^09\\d{8}$ → 400「手機號碼格式不正確」",
      "email 有值且不符合 Email 格式 → 400「Email 格式不正確」",
      "伺服器例外 → 500「系統錯誤，請稍後再試」",
      "其他欄位伺服器都不檢查（性別、生日範圍、健康狀況、付款方式、選項是否在清單內、同意事項）"
    ],
    "sideEffects": [
      "寄管理者通知信（不等結果）",
      "填了 Email 才寄客戶確認信（不等結果）",
      "讀 stores/<storeId> 取分店名給信件用（名單本身不存分店名）",
      "在伺服器 log 印出 name、phone、email、line、paymentMethod"
    ],
    "disabledIf": {
      "any": [
        {
          "field": "$state.isSubmitting",
          "op": "truthy"
        },
        {
          "all": [
            {
              "field": "source",
              "op": "notIn",
              "value": [
                "參觀",
                "電話詢問"
              ]
            },
            {
              "field": "agreeToTerms",
              "op": "falsy"
            }
          ]
        }
      ]
    },
    "belowButtonNotes": [
      "送出即表示同意我們以電話或 LINE 與你聯繫安排體驗課，個人資料僅用於此目的。",
      {
        "text": "送出後請稍候，頁面將導向加入 LINE 官方帳號，加入後即可收到最新通知。",
        "note": "實際上不會自動導向，成功後只顯示成功區塊"
      }
    ],
    "response": {
      "ok": {
        "success": true,
        "message": "預約成功，我們將盡快與您聯繫"
      },
      "error": {
        "success": false,
        "error": "<訊息>"
      }
    }
  },
  "context": {
    "description": "網址參數會改變表單的樣子與存進名單的隱藏欄位。",
    "params": {
      "v": "廠商變體代號，對應下方 variants；查不到就用 default。原字照樣存進 payload.formVariant（查不到的代號也會存）。",
      "co": "免費合作方代號，對應下方 freeTrialPartners；未過到期日（台北時間，含當日）才套用，套用後覆蓋 company。到期判斷用填表者裝置時鐘換算的台北日期；co 可搭配任何 v，只改 company，不改 allAgesFree。",
      "src": "名單來源；只在是單一非空字串時採用（重複帶或空值就用變體的 leadSource），存進 payload.leadSource。自由文字、不驗證、不限長度，會出現在通知信。"
    },
    "variantProperties": {
      "lockStoreId": "鎖定分店，細節見 sections 裡 storeId.lockedBy",
      "hideSources": "隱藏「從哪裡得知練健康？」整題，也不必填",
      "extraSources": "在「從哪裡得知練健康？」的「其他」前面加入額外選項（不展開細項）",
      "allAgesFree": "不限年齡免費：付款方式整題隱藏，值自動設為「活動免費」；生日下方不顯示 50 歲免費提示",
      "company": "存進 payload.company",
      "leadSource": "存進 payload.leadSource（網址 src 優先）",
      "hero": "頁面上方標題、副標、按鈕文字（不影響欄位）"
    },
    "variants": {
      "default": {},
      "abbott": {
        "company": "亞培",
        "leadSource": "LINE"
      },
      "gigabyte": {
        "company": "技嘉",
        "leadSource": "網站"
      },
      "nanshan": {
        "allAgesFree": true,
        "company": "南山",
        "leadSource": "網站",
        "extraSources": [
          "南山健康守護圈"
        ]
      },
      "freetrial": {
        "allAgesFree": true,
        "leadSource": "網站"
      }
    },
    "freeTrialPartners": {
      "taiwanlife": {
        "company": "台灣人壽",
        "endDate": "2027-10-31"
      }
    }
  },
  "derived": {
    "age": "以填表者裝置的今天算足歲（生日字串以 UTC 解析再取本地年月日，台灣 UTC+8 不受影響）。生日是系統帶入但未確認的 1961-01-01、或超出 1920-01-01～2010-01-01 時不算，視為沒有年齡。年齡沒有存進名單，事後要用 payload.birthDate 對 createdAt（台北時間）重算，或看 payload.paymentMethod。",
    "isFreeEligible": "age 不是空值且 age >= 50"
  },
  "sections": [
    {
      "id": "student",
      "title": "學員基本資料",
      "fields": [
        {
          "key": "name",
          "label": "學員姓名",
          "type": "text",
          "placeholder": "要來上課的人",
          "required": true,
          "errors": {
            "required": "請輸入學員姓名"
          },
          "store": {
            "path": "name"
          }
        },
        {
          "key": "phone",
          "label": "學員手機",
          "type": "tel",
          "placeholder": "0912345678",
          "required": true,
          "validation": [
            {
              "rule": "pattern",
              "value": "^09\\d{8}$",
              "message": "請輸入有效的手機號碼",
              "note": "用原值比對，不去空白與橫線",
              "when": "原值非空字串就檢查（只打空白也算有值）；失敗時這句會蓋掉 required 訊息"
            }
          ],
          "errors": {
            "required": "請輸入手機號碼"
          },
          "store": {
            "path": "phone"
          }
        },
        {
          "key": "gender",
          "label": "性別",
          "type": "select",
          "placeholder": "請選擇",
          "options": [
            {
              "value": "男"
            },
            {
              "value": "女"
            }
          ],
          "required": true,
          "errors": {
            "required": "請選擇性別"
          },
          "store": {
            "path": "payload.gender"
          }
        },
        {
          "key": "birthDate",
          "label": "出生年月日（要上課的學員）",
          "type": "date",
          "format": "YYYY-MM-DD",
          "min": "1920-01-01",
          "max": "2010-01-01",
          "required": true,
          "picker": {
            "startAt": "1961-01-01",
            "behavior": "使用者按下欄位（滑鼠主鍵 mousedown）且欄位是空的時，先帶入 1961-01-01，讓日期選擇器從 1961 年開始；這個值標為「未確認」，要等使用者真的選過日期才算數。鍵盤 Tab 進來不帶值。",
            "unconfirmedError": "請點選學員的生日（目前是預設的 1961/1/1）",
            "confirmButton": {
              "text": "生日就是 1961/1/1",
              "showWhen": "出現上面那句錯誤、而且值仍是未確認的 1961-01-01",
              "action": "把值標為已確認"
            },
            "ownerDecision": "起始 1961 與上限 2010 是業主決定，手機與電腦都一樣"
          },
          "validation": [
            {
              "rule": "range",
              "min": "1920-01-01",
              "max": "2010-01-01",
              "inclusive": true,
              "message": "請確認出生年月日，年份請用西元（民國 50 年＝1961 年）"
            }
          ],
          "hint": {
            "text": "第一堂體驗課 50歲以上免費",
            "showIf": {
              "all": [
                {
                  "field": "$derived.isFreeEligible",
                  "op": "truthy"
                },
                {
                  "field": "$variant.allAgesFree",
                  "op": "falsy"
                }
              ]
            }
          },
          "errors": {
            "required": "請選擇出生年月日"
          },
          "store": {
            "path": "payload.birthDate",
            "note": "字串 YYYY-MM-DD；伺服器不檢查範圍"
          }
        },
        {
          "key": "email",
          "label": "Email",
          "labelSuffix": "（選填）",
          "type": "email",
          "placeholder": "your@email.com",
          "required": false,
          "validation": [
            {
              "rule": "pattern",
              "value": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "message": "請輸入有效的 Email",
              "when": "去掉前後空白後有值才檢查",
              "note": "用原值比對，不去前後空白；前後有空白的 Email 會被判定格式錯誤（前端與伺服器都是）"
            }
          ],
          "store": {
            "path": "email",
            "empty": null
          },
          "knownIssue": "只打空白時前端放行，但伺服器會判定格式錯誤回 400，畫面只顯示「送出失敗」。"
        },
        {
          "key": "line",
          "label": "Line ID",
          "labelSuffix": "（選填）",
          "type": "text",
          "placeholder": "方便我們聯繫你",
          "required": false,
          "store": {
            "path": "payload.line",
            "empty": null
          }
        }
      ]
    },
    {
      "id": "filler-health",
      "title": "填寫者資料 & 健康狀況",
      "fields": [
        {
          "key": "filledBySelf",
          "label": "是否為本人填寫",
          "type": "select",
          "default": "本人填寫",
          "options": [
            {
              "value": "本人填寫"
            },
            {
              "value": "他人代填"
            }
          ],
          "required": true,
          "store": {
            "path": "payload.filledBySelf",
            "valueType": "boolean",
            "map": {
              "本人填寫": true,
              "他人代填": false
            },
            "note": "存的是布林，不是字。後台以 === false 判斷代填。"
          }
        },
        {
          "key": "relationship",
          "label": "與學員的關係",
          "type": "select",
          "placeholder": "請選擇",
          "showIf": {
            "field": "filledBySelf",
            "op": "eq",
            "value": "他人代填"
          },
          "options": [
            {
              "value": "配偶"
            },
            {
              "value": "子女"
            },
            {
              "value": "父母"
            },
            {
              "value": "兄弟姊妹"
            },
            {
              "value": "朋友"
            },
            {
              "value": "練健康同仁",
              "note": "選這項時「方便聯繫的電話」改選填"
            },
            {
              "value": "其他"
            }
          ],
          "optionsSharedWith": "group-booking（config/formOptions.ts，改了兩張表單一起變）",
          "required": true,
          "errors": {
            "required": "請選擇與學員的關係"
          },
          "store": {
            "path": "payload.relationship",
            "whenHidden": null
          }
        },
        {
          "key": "bookerName",
          "label": "預約者姓名",
          "type": "text",
          "placeholder": "請輸入你的姓名",
          "showIf": {
            "field": "filledBySelf",
            "op": "eq",
            "value": "他人代填"
          },
          "required": true,
          "errors": {
            "required": "請輸入預約者姓名"
          },
          "store": {
            "path": "payload.bookerName",
            "whenHidden": null
          }
        },
        {
          "key": "contactPhone",
          "label": "方便聯繫的電話",
          "labelSuffixWhenOptional": "（選填）",
          "type": "tel",
          "placeholder": "0912345678",
          "showIf": {
            "field": "filledBySelf",
            "op": "eq",
            "value": "他人代填"
          },
          "required": {
            "field": "relationship",
            "op": "neq",
            "value": "練健康同仁"
          },
          "validation": [
            {
              "rule": "pattern",
              "value": "^09\\d{8}$",
              "message": "請輸入有效的手機號碼",
              "when": "原值非空字串就檢查（只打空白也算有值，選填時也會被擋）；失敗時這句會蓋掉 required 訊息"
            }
          ],
          "errors": {
            "required": "請輸入方便聯繫的電話"
          },
          "store": {
            "path": "payload.contactPhone",
            "whenHidden": "$field.phone",
            "fallback": "$field.phone",
            "note": "本人填寫時前端送學員手機；代填但留空時伺服器改存學員手機"
          },
          "errorRules": [
            "relationship 改成「練健康同仁」時，若畫面上的錯誤是「請輸入方便聯繫的電話」就自動清除；格式錯誤不清"
          ]
        },
        {
          "key": "hasMedicalCondition",
          "label": "是否有疾病，或 3 年內曾開過刀或住院？",
          "type": "select",
          "placeholder": "請選擇",
          "options": [
            {
              "value": "否"
            },
            {
              "value": "是"
            }
          ],
          "required": true,
          "errors": {
            "required": "請選擇健康狀況"
          },
          "store": {
            "path": "payload.hasMedicalCondition",
            "valueType": "boolean",
            "map": {
              "是": true,
              "否": false
            }
          }
        },
        {
          "key": "medicalConditionNote",
          "label": "請簡述情況",
          "labelSuffix": "（選填）",
          "type": "textarea",
          "placeholder": "身體若有任何狀況，都請稍作描述喔！若無則填寫：無",
          "showIf": {
            "field": "hasMedicalCondition",
            "op": "eq",
            "value": "是"
          },
          "required": false,
          "store": {
            "path": "payload.medicalConditionNote",
            "whenHidden": null,
            "empty": null
          }
        }
      ]
    },
    {
      "id": "booking",
      "title": "預約資訊",
      "fields": [
        {
          "key": "storeId",
          "label": "選擇分店",
          "type": "select",
          "placeholder": "請選擇分店",
          "optionsSource": {
            "endpoint": "GET /api/public/stores",
            "value": "id",
            "label": "name",
            "afterSelectShow": "地址（city＋district＋address）・電話",
            "fallback": [
              {
                "value": "nanjing",
                "label": "南京店",
                "address": "台北市中山區南京東路三段 29 號 B1",
                "phone": "(02) 2507-4196"
              },
              {
                "value": "songjiang",
                "label": "松江店",
                "address": "台北市中山區松江路 122 號 B1",
                "phone": "(02) 2537-1055"
              },
              {
                "value": "ximending",
                "label": "西門店",
                "address": "台北市中正區寶慶路 39 號",
                "phone": "(02) 2370-3245"
              },
              {
                "value": "xindian",
                "label": "七張店",
                "address": "新北市新店區北新路二段 252 號 B1-2",
                "phone": "(02) 8914-6428"
              }
            ],
            "note": "伺服器輸出（SSR）與首次畫面用頁面內建的四間（fallback）；掛載後在瀏覽器呼叫 API，回傳非空就整批換掉。API 在 Firestore 失敗或沒資料時仍回 200，內容是伺服器端的備用清單（順序：七張、南京、松江、西門）；只有請求失敗、非 2xx 或回空陣列時才維持頁面 fallback。",
            "filter": "isActive == true",
            "order": "sortOrder 遞增"
          },
          "lockedBy": {
            "source": "$variant.lockStoreId",
            "match": "依序比對分店的 id、slug 或名稱；頁面 fallback 沒有 slug，用 slug 鎖定要等 API 載入成功才比對得到（建議一律填分店 id）",
            "onMatch": "不顯示下拉與必填星號，自動帶入該分店 id，唯讀顯示分店名稱，有地址時再顯示地址・電話",
            "onNoMatch": "唯讀框顯示 lockStoreId 原字，storeId 為空；送出被「請選擇分店」擋下，但鎖定時這句錯誤不會顯示，使用者無法修正"
          },
          "required": true,
          "errors": {
            "required": "請選擇分店"
          },
          "store": {
            "path": "storeId",
            "note": "通常是 stores 文件 id；頁面沒拿到 API 資料時會是內建代號 nanjing／songjiang／ximending／xindian（不一定對應 Firestore 文件）。伺服器不檢查分店是否存在，查不到時信件上的分店名是空的。後台店員角色依這個欄位只看自己店的名單。"
          }
        },
        {
          "key": "preferredTimes",
          "label": "偏好的上課時段",
          "labelSuffix": "（可複選）",
          "type": "checkbox-group",
          "options": [
            {
              "value": "不限"
            },
            {
              "value": "平日10:00-17:00"
            },
            {
